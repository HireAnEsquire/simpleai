{
  "defaults": ["gemini", "openai", "claude", "grok", "perplexity"],
  "default_reasoning_level": null,
  "providers": {
    "gemini": {
      "api_key": "YOUR_GEMINI_API_KEY",
      "default_model": "gemini-3.5-flash",
      "max_output_tokens": 65536,
      "use_enterprise": false,
      "enterprise_project": "YOUR_GOOGLE_CLOUD_PROJECT_ID",
      "enterprise_location": "us-central1",
      "enterprise_gcs_bucket": "YOUR_ENTERPRISE_GCS_BUCKET",
      "enterprise_gcs_prefix": "simpleai-uploads",
      "enterprise_gcs_cleanup": "always"
    },
    "claude": {
      "api_key": "YOUR_ANTHROPIC_API_KEY",
      "default_model": "claude-opus-4-7",
      "max_tokens": 128000,
      "max_retries": 3,
      "skip_citation_followup": false
    },
    "openai": {
      "api_key": "YOUR_OPENAI_API_KEY",
      "default_model": "gpt-5.5",
      "base_url": null
    },
    "grok": {
      "api_key": "YOUR_XAI_API_KEY",
      "default_model": "grok-4.3",
      "max_tokens": 8192
    },
    "perplexity": {
      "api_key": "YOUR_PERPLEXITY_API_KEY",
      "default_model": "sonar-deep-research"
    }
  },
  "logging": {
    "enabled": true,
    "network_logging": true,
    "django_logfile": "django",
    "logfile_location": "./simpleai.log"
  },
  "citation_normalization": {
    "source_alias_by_domain": {
      "nytimes.com": "The New York Times",
      "www.wsj.com": "The Wall Street Journal"
    }
  }
}
